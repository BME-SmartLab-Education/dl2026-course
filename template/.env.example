# Copy to .env and fill in. .env is gitignored: never commit your key.
#   cp .env.example .env
#
# Get your key from https://wandb.ai/authorize
WANDB_API_KEY=

# Your W&B username or team. Leave blank to use your default entity.
WANDB_ENTITY=

# online   log to wandb.ai (normal)
# offline  log to disk only, sync later with `wandb sync`
# disabled turn logging off entirely
WANDB_MODE=online
